<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_back_arrow_shopee"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Đăng nhập"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnCart"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_cart_shopee"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnHelp"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnHelp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_question_shopee"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content ScrollView to handle small screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/ic_shopee_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Username Field -->
            <LinearLayout
                android:id="@+id/llUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/ivLogo">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_person_outline"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Email/Số điện thoại/Tên đăng nhập"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_input"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:id="@+id/lineUsername"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/line_divider"
                app:layout_constraintEnd_toEndOf="@id/llUsername"
                app:layout_constraintStart_toStartOf="@id/llUsername"
                app:layout_constraintTop_toBottomOf="@id/llUsername" />

            <!-- Password Field -->
            <LinearLayout
                android:id="@+id/llPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/lineUsername">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock_outline"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Mật khẩu"
                    android:inputType="textPassword"
                    android:textColor="@color/text_input"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/text_secondary" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@color/line_divider" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quên?"
                    android:textColor="@color/shopee_blue"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:id="@+id/linePassword"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/line_divider"
                app:layout_constraintEnd_toEndOf="@id/llPassword"
                app:layout_constraintStart_toStartOf="@id/llPassword"
                app:layout_constraintTop_toBottomOf="@id/llPassword" />

            <!-- Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/shopee_orange_disabled"
                android:text="Đăng nhập"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="4dp"
                app:layout_constraintTop_toBottomOf="@id/linePassword" />

            <!-- Login with SMS -->
            <TextView
                android:id="@+id/tvLoginSms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Đăng nhập bằng SMS"
                android:textColor="@color/shopee_blue"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="@id/btnLogin"
                app:layout_constraintTop_toBottomOf="@id/btnLogin" />

            <!-- OR Divider -->
            <LinearLayout
                android:id="@+id/llDivider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="64dp"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvLoginSms">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/line_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="HOẶC"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/line_divider" />
            </LinearLayout>

            <!-- Social Login Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:text="Đăng nhập với Google"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:cornerRadius="4dp"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="16dp"
                app:iconTint="@null"
                app:layout_constraintTop_toBottomOf="@id/llDivider"
                app:strokeColor="@color/line_divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFacebook"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:text="Đăng nhập với Facebook"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:cornerRadius="4dp"
                app:icon="@drawable/ic_facebook"
                app:iconGravity="textStart"
                app:iconPadding="16dp"
                app:iconTint="@null"
                app:layout_constraintTop_toBottomOf="@id/btnGoogle"
                app:strokeColor="@color/line_divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPasskey"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:text="Đăng nhập bằng Passkey"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:cornerRadius="4dp"
                app:icon="@drawable/ic_passkey"
                app:iconGravity="textStart"
                app:iconPadding="16dp"
                app:iconTint="@null"
                app:layout_constraintTop_toBottomOf="@id/btnFacebook"
                app:strokeColor="@color/line_divider" />

            <TextView
                android:id="@+id/tvGoToRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="16dp"
                android:text="Bạn chưa có tài khoản? "
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvRegisterLink"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnPasskey"
                app:layout_constraintVertical_bias="1.0" />

            <TextView
                android:id="@+id/tvRegisterLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng ký"
                android:textColor="@color/shopee_blue"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/tvGoToRegister"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvGoToRegister"
                app:layout_constraintTop_toTopOf="@id/tvGoToRegister" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
